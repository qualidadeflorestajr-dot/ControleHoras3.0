# Copie este arquivo para .env e preencha os valores.
# Nunca envie o arquivo .env ao GitHub.
# FLASK_SECRET_KEY pode ficar vazia: app.py criará e guardará uma chave persistente
# em instance/flask_secret_key, que deve ser preservada entre atualizações.
FLASK_SECRET_KEY=

# Obrigatória para habilitar o login administrativo.
# Defina uma senha forte e exclusiva; não deixe o valor de exemplo.
ADMIN_PASSWORD=COLOQUE_UMA_SENHA_FORTE_AQUI

# Em desenvolvimento local, use COOKIE_SECURE=0 se estiver acessando por HTTP.
# No Codespaces HTTPS e no PythonAnywhere HTTPS, deixe como 1 ou omita.
COOKIE_SECURE=1
